<idea-plugin>
    <id>com.donseba.goclue</id>
    <name>go-clue</name>
    <vendor email="sebastiano.bellinzis@outlook.com" url="https://github.com/donseba/go-clue">Sebastiano Bellinzis</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>org.jetbrains.plugins.go-template</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="go-clue" displayType="BALLOON"/>
        <platform.lsp.serverSupportProvider implementation="com.donseba.goclue.GoClueLspServerSupportProvider"/>
        <psi.referenceContributor implementation="com.donseba.goclue.GoClueReferenceContributor"/>
        <gotoDeclarationHandler implementation="com.donseba.goclue.GoClueGotoDeclarationHandler"/>
        <documentationProvider implementation="com.donseba.goclue.GoClueDocumentationProvider"/>
        <postStartupActivity implementation="com.donseba.goclue.GoClueStartupActivity"/>
    </extensions>

    <actions>
        <action id="GoClue.RebuildIndex"
                class="com.donseba.goclue.RebuildIndexAction"
                text="Write go-clue Index"
                description="Write the optional .go-clue/index.json artifact for this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="GoClue.ShowIndexStatus"
                class="com.donseba.goclue.ShowIndexStatusAction"
                text="Show go-clue Status"
                description="Show go-clue language server and optional index status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="GoClue.ToggleEnabled"
                class="com.donseba.goclue.ToggleEnabledAction"
                text="go-clue Enabled"
                description="Enable or disable go-clue for this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="GoClue.ToggleAutoIndex"
                class="com.donseba.goclue.ToggleAutoIndexAction"
                text="go-clue Auto Index"
                description="Enable or disable automatic go-clue index rebuilding for this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
