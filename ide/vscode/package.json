{
  "name": "go-clue-vscode",
  "displayName": "go-clue",
  "description": "Typed Go template contracts with completion, diagnostics, hover, navigation, semantic highlighting, static FuncMap discovery, and provider package support.",
  "version": "0.15.1",
  "publisher": "donseba",
  "author": {
    "name": "Sebastiano Bellinzis",
    "email": "sebastiano.bellinzis@outlook.com",
    "url": "https://github.com/donseba"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/donseba/go-clue"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "files": [
    "extension.js",
    "icon.png",
    "language-configuration.json",
    "LICENSE",
    "README.md",
    "package.json",
    "node_modules/**"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:go-template",
    "onLanguage:go-html-template",
    "onLanguage:gotmpl",
    "onLanguage:html",
    "onStartupFinished",
    "workspaceContains:**/*.gohtml",
    "workspaceContains:**/*.tmpl",
    "onCommand:go-clue.rebuildIndex",
    "onCommand:go-clue.showIndexStatus",
    "onCommand:go-clue.toggleEnabled",
    "onCommand:go-clue.toggleAutoIndex",
    "onCommand:go-clue.restartLsp"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "go-template",
        "aliases": [
          "Go Template",
          "go-template"
        ],
        "extensions": [
          ".gohtml",
          ".tmpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "go-clue.rebuildIndex",
        "title": "go-clue: Rebuild Index"
      },
      {
        "command": "go-clue.showIndexStatus",
        "title": "go-clue: Show Index Status"
      },
      {
        "command": "go-clue.toggleEnabled",
        "title": "go-clue: Toggle Enabled"
      },
      {
        "command": "go-clue.toggleAutoIndex",
        "title": "go-clue: Toggle Auto Index"
      },
      {
        "command": "go-clue.restartLsp",
        "title": "go-clue: Restart LSP"
      }
    ],
    "configurationDefaults": {
      "[go-template]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[go-html-template]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[gotmpl]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "function:go-template": "#DCDCAA",
          "function.defaultLibrary:go-template": "#C586C0",
          "method:go-template": "#61AFEF",
          "property:go-template": "#E06C75",
          "variable:go-template": "#D19A66",
          "parameter:go-template": { "foreground": "#56B6C2", "bold": true },
          "type:go-template": "#98C379",
          "namespace:go-template": { "foreground": "#98C379", "italic": true },
          "function:go-html-template": "#DCDCAA",
          "function.defaultLibrary:go-html-template": "#C586C0",
          "method:go-html-template": "#61AFEF",
          "property:go-html-template": "#E06C75",
          "variable:go-html-template": "#D19A66",
          "parameter:go-html-template": { "foreground": "#56B6C2", "bold": true },
          "type:go-html-template": "#98C379",
          "namespace:go-html-template": { "foreground": "#98C379", "italic": true },
          "function:gotmpl": "#DCDCAA",
          "function.defaultLibrary:gotmpl": "#C586C0",
          "method:gotmpl": "#61AFEF",
          "property:gotmpl": "#E06C75",
          "variable:gotmpl": "#D19A66",
          "parameter:gotmpl": { "foreground": "#56B6C2", "bold": true },
          "type:gotmpl": "#98C379",
          "namespace:gotmpl": { "foreground": "#98C379", "italic": true }
        }
      }
    },
    "configuration": {
      "title": "go-clue",
      "properties": {
        "go-clue.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable go-clue for this workspace. A project can also opt out with .go-clue/config.json: { \"enabled\": false }."
        },
        "go-clue.autoIndex": {
          "type": "boolean",
          "default": false,
          "description": "Automatically rebuild .go-clue/index.json after Go or template files change. Disabled by default because the language server can index in memory. A project can also opt in with .go-clue/config.json: { \"writeIndex\": true }."
        },
        "go-clue.debounceMilliseconds": {
          "type": "number",
          "default": 1200,
          "minimum": 250,
          "description": "Delay before automatic index rebuilds after file changes."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
